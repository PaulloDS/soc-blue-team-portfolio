# Somente para laboratório local. NUNCA reutilize essa senha em outro lugar.
ELASTIC_PASSWORD=changeme-lab-only
STACK_VERSION=8.15.3
# Docker expõe portas apenas na própria máquina por padrão.
# Para VMs isoladas (Host-only), ajuste SOMENTE para o IP Host-only do host,
# por exemplo 192.168.56.1; nunca use 0.0.0.0 ou um IP de rede pública.
ES_BIND_IP=127.0.0.1
KIBANA_BIND_IP=127.0.0.1
ATTACK_BIND_IP=127.0.0.1
ES_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601
